# .gitignore for UrbanSimCore

# Build artifacts
build/
build-*/
cmake-build-*/
*.o
*.a
*.lib
*.exe
*.dll
*.so

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json

# Test outputs
Testing/
pressure_report*.csv
sweep_out*/

# External dependencies
# Note: googletest is a git submodule, so it's tracked separately
# extern/googletest/ is NOT ignored—submodules are committed via .gitmodules

# Save files (if placed here during testing)
*.save
