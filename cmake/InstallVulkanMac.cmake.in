set(root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(MAKE_DIRECTORY "${root}/lib/urban-sim/vulkan/icd.d")
configure_file("@Vulkan_LIBRARY@" "${root}/lib/urban-sim/libvulkan.1.dylib" COPYONLY)
configure_file("@URBAN_SIM_MOLTENVK@" "${root}/lib/urban-sim/libMoltenVK.dylib" COPYONLY)
file(WRITE "${root}/lib/urban-sim/vulkan/icd.d/MoltenVK_icd.json"
  "{\"file_format_version\":\"1.0.0\",\"ICD\":{\"library_path\":\"../../libMoltenVK.dylib\",\"api_version\":\"1.0.0\",\"is_portability_driver\":true}}\n")
foreach(library libvulkan.1.dylib libMoltenVK.dylib)
  execute_process(COMMAND install_name_tool -id "@rpath/${library}" "${root}/lib/urban-sim/${library}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot set bundled Vulkan library identity")
  endif()
endforeach()
execute_process(COMMAND otool -D "@Vulkan_LIBRARY@" OUTPUT_VARIABLE loader_ids RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot inspect Vulkan loader identity")
endif()
string(REGEX MATCH "\n([^\n]+)" loader_id "${loader_ids}")
string(STRIP "${CMAKE_MATCH_1}" loader_id)
execute_process(COMMAND install_name_tool -change "${loader_id}" "@rpath/libvulkan.1.dylib"
  "${root}/bin/UrbanSimCore-visualizer" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot configure bundled Vulkan loader")
endif()
set(bundled_glfw "")
if("@URBAN_SIM_GLFW_LIBRARY@" MATCHES "\\.dylib$")
  configure_file("@URBAN_SIM_GLFW_LIBRARY@" "${root}/lib/urban-sim/libglfw.3.dylib" COPYONLY)
  execute_process(COMMAND otool -D "@URBAN_SIM_GLFW_LIBRARY@" OUTPUT_VARIABLE glfw_ids RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect shared GLFW")
  endif()
  string(REGEX MATCH "\n([^\n]+)" glfw_id "${glfw_ids}")
  string(STRIP "${CMAKE_MATCH_1}" glfw_id)
  execute_process(COMMAND install_name_tool -change "${glfw_id}" "@rpath/libglfw.3.dylib"
    "${root}/bin/UrbanSimCore-visualizer" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot configure bundled GLFW")
  endif()
  execute_process(COMMAND install_name_tool -id "@rpath/libglfw.3.dylib"
    "${root}/lib/urban-sim/libglfw.3.dylib" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot set bundled GLFW identity")
  endif()
  set(bundled_glfw "${root}/lib/urban-sim/libglfw.3.dylib")
endif()
foreach(binary "${root}/lib/urban-sim/libvulkan.1.dylib" "${root}/lib/urban-sim/libMoltenVK.dylib" "${root}/bin/UrbanSimCore-visualizer" ${bundled_glfw})
  execute_process(COMMAND codesign --force --sign - "${binary}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot ad-hoc sign installed Vulkan runtime")
  endif()
endforeach()
