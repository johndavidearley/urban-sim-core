file(READ "${INPUT}" bytes HEX)
string(LENGTH "${bytes}" length)
math(EXPR last "${length} - 8")
set(words "")
foreach(offset RANGE 0 ${last} 8)
  string(SUBSTRING "${bytes}" ${offset} 8 word)
  string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," word "${word}")
  string(APPEND words "${word}")
endforeach()
file(WRITE "${OUTPUT}" "#pragma once\n#include <cstdint>\ninline constexpr uint32_t ${SYMBOL}[] = {${words}};\n")
