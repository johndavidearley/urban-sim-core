{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/presets/${presetName}"
    },
    {
      "name": "regular",
      "displayName": "Regular release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "strict",
      "displayName": "Strict warnings-as-errors build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "URBAN_SIM_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer and UBSan build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "URBAN_SIM_WARNINGS_AS_ERRORS": "ON",
        "URBAN_SIM_ENABLE_ASAN_UBSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "URBAN_SIM_WARNINGS_AS_ERRORS": "ON",
        "URBAN_SIM_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "regular", "configurePreset": "regular", "jobs": 4 },
    { "name": "strict", "configurePreset": "strict", "jobs": 4 },
    { "name": "asan", "configurePreset": "asan", "jobs": 4 },
    { "name": "tsan", "configurePreset": "tsan", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "regular",
      "configurePreset": "regular",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "strict",
      "configurePreset": "strict",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:history_size=7"
      },
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    }
  ]
}
